{
	"name": "wpv4",
	"type": "module",
	"scripts": {
		"dev": "bun run build && vite",
		"dev:wrangler": "wrangler dev",
		"kill": "pgrep -fa 'wpv4' | awk '{print $1}' | xargs -r kill -KILL 2>/dev/null; echo done",
		"build": "vite build --mode client && vite build",
		"deploy": "bun run build && wrangler deploy --minify",
		"lint": "oxlint src/ test/ scripts/ files-worker/src/",
		"format": "oxfmt src/ test/ scripts/ files-worker/src/",
		"test": "bun test",
		"typecheck": "tsc --noEmit && bun run --cwd files-worker typecheck",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
		"db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.0",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.3",
		"@wdprlib/ast": "^4.0.2",
		"@wdprlib/decompiler": "^1.3.4",
		"@wdprlib/parser": "^5.1.6",
		"@wdprlib/render": "^4.0.7",
		"@wdprlib/runtime": "^1.2.2",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5",
		"ulidx": "^2.4.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260830.1",
		"@hono/vite-build": "^1.11.1",
		"@hono/vite-dev-server": "^0.26.1",
		"drizzle-kit": "^0.31.10",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.80.0",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	},
	"packageManager": "npm@11.10.0+sha512.8bc844e37892200305b98562f13c6c10849d10b3387c8cdaeb4d1a2e32746a79063cba9dd284cf28c26a01c3bf4169b7d3b31b4a5586cc970d6749463108073c"
}
