{
	"name": "wpv4",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:wrangler": "wrangler dev",
		"build": "vite build && vite build --mode client",
		"deploy": "bun run build && wrangler deploy --minify",
		"lint": "oxlint src/",
		"format": "oxfmt src/",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply wpv4-db --local"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.6",
		"@wdprlib/parser": "^2.0.10",
		"@wdprlib/render": "^1.3.3",
		"@wdprlib/runtime": "^1.0.2",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260316.1",
		"@hono/vite-build": "^1.10.0",
		"@hono/vite-dev-server": "^0.25.1",
		"drizzle-kit": "^0.31.9",
		"oxfmt": "^0.41.0",
		"oxlint": "^1.56.0",
		"vite": "^8.0.0",
		"wrangler": "^4.4.0"
	},
	"packageManager": "npm@11.10.0+sha512.8bc844e37892200305b98562f13c6c10849d10b3387c8cdaeb4d1a2e32746a79063cba9dd284cf28c26a01c3bf4169b7d3b31b4a5586cc970d6749463108073c"
}
