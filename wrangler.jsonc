{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wpv4-dev",
	"main": "src/index.tsx",
	"compatibility_date": "2026-03-16",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// client-manifest-data: src/client-manifest.ts が import する virtual module。
	// build後の dist/.vite/manifest.json を SSR bundle に inline するための alias
	"alias": {
		"client-manifest-data": "./public/.vite/manifest.json"
	},
	// ローカル開発用のデフォルト設定（wrangler dev で使用）
	// ローカル開発用 D1（wrangler dev は --local で .wrangler/state を読むため
	// database_id は実体識別用、staging のものを流用しておく）
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wpv4-db",
			"database_id": "5cd1ee6c-1e38-4147-90bf-fe689bddb638",
			"migrations_dir": "db/migrations"
		}
	],
	// ローカル開発用 R2（wrangler dev --local で .wrangler/state を使うため staging のものを流用）
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "wpv4-files-staging"
		}
	],
	"vars": {
		"OAUTH_PROVIDER_URL": "https://manage.scp-jp.com",
		"CLIENT_ID": "eeb066eefa0e40ae229600a4df7eab34",
		"FILES_DOMAIN": "http://localhost:8788"
	},
	"assets": {
		"directory": "public"
	},
	"env": {
		// staging: develop ブランチから自動デプロイ
		// デフォルトドメイン: wpv4-staging.<account>.workers.dev
		"staging": {
			"name": "wpv4-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wpv4-db-staging",
					"database_id": "5cd1ee6c-1e38-4147-90bf-fe689bddb638",
					"migrations_dir": "db/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "wpv4-files-staging"
				}
			],
			"vars": {
				"OAUTH_PROVIDER_URL": "https://manage.scp-jp.com",
				"CLIENT_ID": "eeb066eefa0e40ae229600a4df7eab34",
				"FILES_DOMAIN": "https://wpfiles-staging.r74.workers.dev"
			},
			"assets": {
				"directory": "public"
			}
		},
		// production: production ブランチから自動デプロイ
		// カスタムドメイン: wp.r74.tech（Cloudflare ダッシュボードでバインド）
		"production": {
			"name": "wpv4-prd",
			"routes": [
				{
					"pattern": "wp.r74.tech",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wpv4-db-prd",
					"database_id": "ba04672f-a87f-4f0b-9ce9-f75db3d20732",
					"migrations_dir": "db/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "wpv4-files-prd"
				}
			],
			"vars": {
				"OAUTH_PROVIDER_URL": "https://manage.scp-jp.com",
				"CLIENT_ID": "eeb066eefa0e40ae229600a4df7eab34",
				"FILES_DOMAIN": "https://wpfiles.r74.workers.dev"
			},
			"assets": {
				"directory": "public"
			}
		}
	}
}
