{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wpv4",
	"main": "src/index.tsx",
	"compatibility_date": "2026-03-16",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wpv4-db",
			"database_id": "",
			"migrations_dir": "db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "wpv4-html-blocks"
		}
	],
	"vars": {
		"OAUTH_PROVIDER_URL": "http://localhost:3939",
		"CLIENT_ID": "eeb066eefa0e40ae229600a4df7eab34",
		"FILES_DOMAIN": "http://localhost:8788"
	},
	"assets": {
		"directory": "public"
	}
}
