{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "wpfiles-dev",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-16",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wpv4-db",
			"database_id": "5cd1ee6c-1e38-4147-90bf-fe689bddb638",
			"migrations_dir": "../db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "wpv4-files-staging"
		},
		{
			"binding": "AVATARS",
			"bucket_name": "wpv4-avatars-staging"
		}
	],
	"vars": {
		"ALLOWED_ORIGIN": "http://localhost:5173",
		"HTML_BLOCK_CSS_URL": "http://localhost:5173/common--theme/base/css/html-block.css"
	},
	"dev": {
		"port": 8788,
		"persist_to": "../.wrangler/state"
	},
	"env": {
		// staging: develop ブランチから自動デプロイ
		"staging": {
			"name": "wpfiles-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wpv4-db-staging",
					"database_id": "5cd1ee6c-1e38-4147-90bf-fe689bddb638",
					"migrations_dir": "../db/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "wpv4-files-staging"
				},
				{
					"binding": "AVATARS",
					"bucket_name": "wpv4-avatars-staging"
				}
			],
			"vars": {
				"ALLOWED_ORIGIN": "https://wpv4-staging.r74.workers.dev",
				"HTML_BLOCK_CSS_URL": "https://wpv4-staging.r74.workers.dev/common--theme/base/css/html-block.css"
			}
		},
		// production: production ブランチから自動デプロイ
		// ドメイン: wpfiles.r74.workers.dev (Workers default subdomain)
		"production": {
			"name": "wpfiles",
			"workers_dev": true,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wpv4-db-prd",
					"database_id": "ba04672f-a87f-4f0b-9ce9-f75db3d20732",
					"migrations_dir": "../db/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "wpv4-files-prd"
				},
				{
					"binding": "AVATARS",
					"bucket_name": "wpv4-avatars-prd"
				}
			],
			"vars": {
				"ALLOWED_ORIGIN": "https://wp.r74.tech",
				"HTML_BLOCK_CSS_URL": "https://wp.r74.tech/common--theme/base/css/html-block.css"
			}
		}
	}
}
