{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"lib": ["ESNext"],
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src/**/*.ts"]
}
